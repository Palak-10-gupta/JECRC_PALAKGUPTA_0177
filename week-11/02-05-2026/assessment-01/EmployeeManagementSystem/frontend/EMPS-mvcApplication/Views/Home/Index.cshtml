@model List<EMPS_mvcApplication.Models.Employee>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Employees</h2>
    <a class="btn btn-primary" href="/Home/Create">+ Add Employee</a>
</div>

<table class="table table-striped table-bordered shadow">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Department</th>
            <th>Email</th>
            <th>Salary</th>
            <th style="width:150px;">Actions</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var emp in Model)
    {
        <tr>
            <td>@emp.Name</td>
            <td>@emp.Department</td>
            <td>@emp.Email</td>
            <td>₹ @emp.Salary</td>
            <td>
                <a class="btn btn-sm btn-warning" href="/Home/Edit/@emp.Id">Edit</a>
                <a class="btn btn-sm btn-danger" href="/Home/Delete/@emp.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>