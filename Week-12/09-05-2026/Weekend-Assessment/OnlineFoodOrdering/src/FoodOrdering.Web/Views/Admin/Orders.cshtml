@model IEnumerable<FoodOrdering.Core.Models.Order>

@{
    ViewData["Title"] = "Orders";
    ViewData["HideNavbar"] = true;
    Layout = "_Layout";
}

<div style="display:flex;min-height:100vh">
    <aside class="admin-sidebar">
        <div class="brand">
            <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:900">
                🔥 Food<span style="color:var(--primary)">Rush</span>
            </div>
        </div>
    </aside>

    <main class="admin-main" style="flex:1">
        <h2 style="font-family:'Playfair Display',serif;font-weight:900;">Orders</h2>

        <div class="form-card mt-4">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Update</th>
                        <th>Details</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.User?.FullName</td>
                            <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                            <td>₹@order.TotalAmount</td>
                            <td>@order.Status</td>

                            <td>
                                <form asp-action="UpdateOrderStatus" method="post">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <select name="status" class="form-control-custom">
                                        @foreach (var status in Enum.GetValues(typeof(FoodOrdering.Core.Models.OrderStatus)))
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn-fire mt-2">Update</button>
                                </form>
                            </td>

                            <td>
                                <a asp-action="OrderDetails"
                                       asp-route-id="@order.Id"
                                       class="btn-outline-fire">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>