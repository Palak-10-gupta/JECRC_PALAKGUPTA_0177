@model IEnumerable<FoodOrdering.Core.Models.FoodItem>

@{
    ViewData["Title"] = "Food Items";
    ViewData["HideNavbar"] = true;
    Layout = "_Layout";
}

<div style="display:flex;min-height:100vh">
    <aside class="admin-sidebar">
        <div class="brand">
            <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:900">
                🔥 Food<span style="color:var(--primary)">Rush</span>
            </div>
            <div style="color:var(--text-muted);font-size:.78rem;margin-top:.25rem">Admin Panel</div>
        </div>

        <nav>
            <a asp-action="Dashboard" asp-controller="Admin" class="admin-nav-item">
                <span class="icon">📊</span> Dashboard
            </a>
            <a asp-action="FoodItems" asp-controller="Admin" class="admin-nav-item active">
                <span class="icon">🍽️</span> Food Items
            </a>
            <a asp-action="Categories" asp-controller="Admin" class="admin-nav-item">
                <span class="icon">📂</span> Categories
            </a>
            <a asp-action="Orders" asp-controller="Admin" class="admin-nav-item">
                <span class="icon">📦</span> Orders
            </a>

            <hr class="divider mx-3">

            <a asp-controller="Home" asp-action="Index" class="admin-nav-item">
                <span class="icon">🌐</span> View Site
            </a>

            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="admin-nav-item" style="width:100%;border:none;background:none;text-align:left;">
                    <span class="icon">🚪</span> Logout
                </button>
            </form>
        </nav>
    </aside>

    <main class="admin-main" style="flex:1">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:900">
                    Food Items
                </h2>
                <p style="color:var(--text-muted)">Manage all menu items</p>
            </div>

            <a asp-action="CreateFood" class="btn-fire">
                <i class="bi bi-plus-circle"></i> Add Food Item
            </a>
        </div>

        <div class="form-card">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Available</th>
                        <th>Featured</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@item.ImageUrl"
                                     alt="@item.Name"
                                     style="width:70px;height:70px;object-fit:cover;border-radius:12px;" />
                            </td>

                            <td>
                                <strong>@item.Name</strong><br />
                                <small style="color:var(--text-muted)">
                                    @item.Description
                                </small>
                            </td>

                            <td>@item.Category?.Name</td>

                            <td>₹@item.Price</td>

                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="status-badge">Available</span>
                                }
                                else
                                {
                                    <span class="status-badge" style="background:#dc3545;">Unavailable</span>
                                }
                            </td>

                            <td>
                                @if (item.IsFeatured)
                                {
                                    <span class="status-badge" style="background:#f59e0b;">Featured</span>
                                }
                            </td>

                            <td class="d-flex gap-2">
                                <a asp-action="EditFood"
                                       asp-route-id="@item.Id"
                                       class="btn-outline-fire">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <form asp-action="DeleteFood"
                                      method="post"
                                      onsubmit="return confirm('Delete this item?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-gold">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>