@model IEnumerable<FoodOrdering.Core.Models.Category>

@{
    ViewData["Title"] = "Categories";
    ViewData["HideNavbar"] = true;
    Layout = "_Layout";
}

<div style="display:flex;min-height:100vh">
    <aside class="admin-sidebar">
        <div class="brand">
            <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:900">
                🔥 Food<span style="color:var(--primary)">Rush</span>
            </div>
            <div style="color:var(--text-muted);font-size:.78rem;">Admin Panel</div>
        </div>

        <nav>
            <a asp-action="Dashboard" class="admin-nav-item"><span class="icon">📊</span> Dashboard</a>
            <a asp-action="FoodItems" class="admin-nav-item"><span class="icon">🍽️</span> Food Items</a>
            <a asp-action="Categories" class="admin-nav-item active"><span class="icon">📂</span> Categories</a>
            <a asp-action="Orders" class="admin-nav-item"><span class="icon">📦</span> Orders</a>
        </nav>
    </aside>

    <main class="admin-main" style="flex:1">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 style="font-family:'Playfair Display',serif;font-weight:900;">Categories</h2>
                <p style="color:var(--text-muted)">Manage food categories</p>
            </div>

            <a asp-action="CreateCategory" class="btn-fire">
                <i class="bi bi-plus-circle"></i> Add Category
            </a>
        </div>

        <div class="form-card">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Active</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td>@cat.Name</td>
                            <td>@cat.Description</td>

                            <td>
                                @if (cat.IsActive)
                                {
                                    <span class="status-badge">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge" style="background:#dc3545;">Inactive</span>
                                }
                            </td>

                            <td>@cat.CreatedAt.ToString("dd MMM yyyy")</td>

                            <td class="d-flex gap-2">
                                <a asp-action="EditCategory"
                                       asp-route-id="@cat.Id"
                                       class="btn-outline-fire">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <form asp-action="DeleteCategory"
                                      method="post"
                                      onsubmit="return confirm('Delete category?');">
                                    <input type="hidden" name="id" value="@cat.Id" />
                                    <button type="submit" class="btn-gold">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>