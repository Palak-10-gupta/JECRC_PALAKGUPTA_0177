@model FoodOrdering.Core.Models.FoodItem

@{
    ViewData["Title"] = "Edit Food";
    ViewData["HideNavbar"] = true;
    Layout = "_Layout";
}

<div style="display:flex;min-height:100vh">
    <aside class="admin-sidebar">
        <div class="brand">
            <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:900">
                🔥 Food<span style="color:var(--primary)">Rush</span>
            </div>
        </div>
    </aside>

    <main class="admin-main" style="flex:1">
        <h2 style="font-family:'Playfair Display',serif;font-weight:900;">Edit Food Item</h2>

        <div class="form-card mt-4">
            <form asp-action="EditFood" method="post" enctype="multipart/form-data">
                <input asp-for="Id" type="hidden" />
                <input asp-for="ImageUrl" type="hidden" />

                <div class="mb-4">
                    <label class="form-label-custom">Food Name</label>
                    <input asp-for="Name" class="form-control-custom" />
                </div>

                <div class="mb-4">
                    <label>Description</label>
                    <textarea asp-for="Description" class="form-control-custom"></textarea>
                </div>

                <div class="mb-4">
                    <label>Price</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control-custom" />
                </div>

                <div class="mb-4">
                    <label>Category</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control-custom"></select>
                </div>

                <div class="mb-4">
                    <img src="@Model.ImageUrl" style="width:120px;height:120px;border-radius:14px;object-fit:cover;" />
                </div>

                <div class="mb-4">
                    <label>Change Image</label>
                    <input type="file" name="imageFile" class="form-control-custom" />
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsAvailable" class="form-check-input" />
                    <label>Available</label>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsFeatured" class="form-check-input" />
                    <label>Featured</label>
                </div>

                <button type="submit" class="btn-fire">
                    Update Food
                </button>
            </form>
        </div>
    </main>
</div>